# change my name to .env

# development | production
NODE_ENV=development

POSTGRES_USER=postgres_username
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres

# Only in dev, comment out in prod
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin_pw_change_me

# NOTE:
# On some systems (especially with IPv6 preferred), using "localhost" (or the Docker hostname "db" outside containers)
# may resolve to ::1 (IPv6) and cause connection errors (Prisma P1001).
# If seeding/migrations from the host fail, use IPv4 explicitly:
#   change the host to 127.0.0.1 (host machine) instead of localhost/db (Docker network).
#
# Example: DATABASE_URL=postgresql://postgres_username:postgres_password@127.0.0.1:5432/postgres
DATABASE_URL=postgresql://postgres_username:postgres_password@db:5432/postgres
